# Backend
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/do-przyjazdu.sqlite

# Tryb demonstracyjny: wymusza oznaczenie symulacji w UI i fikcyjne dane (sekcja 6.10)
DEMO_MODE=true

# Dostęp dyspozytora (panel wymaga uwierzytelnienia - sekcja 11 "Dostęp i dane").
# W demo: prosty wspólny sekret. Przed pilotażem zastąpić realnym logowaniem.
DISPATCHER_PASSWORD=zmien-mnie
SESSION_SECRET=zmien-mnie-tez

# Ważność linku świadka (minuty)
WITNESS_TOKEN_TTL_MINUTES=720

# Po ilu sekundach ciszy telefonu świadka panel pokazuje przerwę w kontakcie.
# Telefon odpytuje serwer co 5 s, gdy strona jest otwarta.
CONTACT_GAP_SECONDS=30

# Adres, pod którym działa frontend - do wypisania linku świadka po seedzie.
# Dev: http://localhost:5173 (Vite), produkcja: adres HTTPS serwera.
PUBLIC_BASE_URL=http://localhost:5173

# Stały token świadka dla demo (np. wydrukowany kod QR). Pusty = nowy losowy przy każdym demo:reset.
DEMO_WITNESS_TOKEN=

# Opcjonalne AI (sekcja 9) - brak klucza = brak szkicu podsumowania,
# podstawowy widok przekazania musi działać bez AI.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Odbiornik SMS (sekcja 10) - poza podstawowym MVP.
# Pusty = kanał SMS tylko symulowany i tak oznaczony w UI.
SMS_INBOUND_SECRET=
# Numer, na który świadek wysyła SMS. Pusty = aplikacja SMS otworzy się bez numeru.
SMS_NUMBER=
