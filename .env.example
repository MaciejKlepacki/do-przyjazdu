# Backend
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/do-przyjazdu.sqlite

# Tryb demonstracyjny: wymusza oznaczenie symulacji w UI i fikcyjne dane (sekcja 6.10)
DEMO_MODE=true

# Dostęp dyspozytora (panel wymaga uwierzytelnienia — sekcja 11 "Dostęp i dane").
# W demo: prosty wspólny sekret. Przed pilotażem zastąpić realnym logowaniem.
DISPATCHER_PASSWORD=zmien-mnie
SESSION_SECRET=zmien-mnie-tez

# Ważność linku świadka (minuty)
WITNESS_TOKEN_TTL_MINUTES=720

# Opcjonalne AI (sekcja 9) — brak klucza = brak szkicu podsumowania,
# podstawowy widok przekazania musi działać bez AI.
ANTHROPIC_API_KEY=

# Odbiornik SMS (sekcja 10) — poza podstawowym MVP.
# Pusty = kanał SMS tylko symulowany i tak oznaczony w UI.
SMS_INBOUND_SECRET=
