{
  "name": "@do-przyjazdu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend: sesje, uprawnienia, historia zdarzenia, synchronizacja",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seedDemo.ts",
    "demo:reset": "tsx src/db/resetDemo.ts"
  },
  "dependencies": {
    "@do-przyjazdu/shared": "*",
    "better-sqlite3": "^11.3.0",
    "express": "^4.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
